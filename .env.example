# Local environment template. Copy to .env.local and fill in real values.
# NODE_ENV-aware cookie flags (Secure, HttpOnly, SameSite) are applied by the
# auth route handler in a later child. No real values, no secrets here.
ANDAMIO_API_KEY=
ANDAMIO_GATEWAY_URL=https://preprod.api.andamio.io
ANDAMIO_NETWORK=preprod
AUTH_JWT_COOKIE_NAME=wwm_jwt
